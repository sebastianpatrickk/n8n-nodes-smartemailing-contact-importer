{
	"name": "n8n-nodes-smartemailing-contact-importer",
	"version": "1.0.1",
	"description": "n8n community node for importing contacts to Smartemailing",
	"license": "MIT",
	"homepage": "https://github.com/sebastianpatrickk/n8n-nodes-smartemailing-contact-importer#readme",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Sebastian Patrick Klen",
		"email": "sebastian-patrick.klen@tietoevry.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sebastianpatrickk/n8n-nodes-smartemailing-contact-importer.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SmartemailingContactImporterApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SmartemailingContactImporter/SmartemailingContactImporter.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
